    <script>
        let registros = [];
        let medicos = [];
        let proveedores = [];
        let medicamentosCSV = [];
        let medicosCSV = [];
        let registroEditando = null;

        document.addEventListener('DOMContentLoaded', function() {
            cargarCSVMedicamentos();
            cargarCSVMedicos();
            
            const hoy = new Date().toISOString().split('T')[0];
            document.getElementById('fecha_entrada').value = hoy;
            document.getElementById('fecha_salida').value = hoy;
            document.getElementById('movimiento_salida').value = 'Venta al público';
        });

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const icon = document.querySelector('.sidebar-toggle .material-icons');
            
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
            
            if (sidebar.classList.contains('collapsed')) {
                icon.textContent = 'chevron_right';
            } else {
                icon.textContent = 'chevron_left';
            }
        }

        function toggleSidebarMobile() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }

        function showSection(sectionId) {
            const sections = document.querySelectorAll('.form-section');
            sections.forEach(section => {
                section.style.display = 'none';
            });
            
            document.getElementById(sectionId).style.display = 'block';
            
            const buttons = document.querySelectorAll('.nav-item');
            buttons.forEach(button => {
                button.classList.remove('active');
            });
            
            event.target.closest('.nav-item').classList.add('active');
            
            if (window.innerWidth <= 768) {
                toggleSidebarMobile();
            }
        }

        function cargarCSVMedicamentos() {
            fetch('MANTGI.csv')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.text();
                })
                .then(data => {
                    medicamentosCSV = parseCSVMedicamentos(data);
                    if (medicamentosCSV.length > 0) {
                        document.getElementById('alert_csv').style.display = 'none';
                    } else {
                        document.getElementById('alert_csv').style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error al cargar MANTGI.csv:', error);
                    document.getElementById('alert_csv').style.display = 'block';
                });
        }

        function cargarCSVMedicos() {
            fetch('MEDICOS.csv')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.text();
                })
                .then(data => {
                    medicosCSV = parseCSVMedicos(data);
                    console.log('Médicos cargados:', medicosCSV.length);
                    if (medicosCSV.length > 0) {
                        document.getElementById('alert_csv_medicos').style.display = 'none';
                    } else {
                        document.getElementById('alert_csv_medicos').style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error al cargar MEDICOS.csv:', error);
                    document.getElementById('alert_csv_medicos').style.display = 'block';
                });
        }

        function parseCSVMedicamentos(data) {
            const lines = data.split('\n');
            const result = [];
            
            let separador = ',';
            const primeraLinea = lines[0] || '';
            
            if (primeraLinea.includes('\t')) {
                separador = '\t';
            } else if (primeraLinea.includes(';')) {
                separador = ';';
            }
            
            function dividirLineaCSV(linea) {
                const resultado = [];
                let campo = '';
                let dentroDeComillas = false;
                
                for (let i = 0; i < linea.length; i++) {
                    const caracter = linea[i];
                    
                    if (caracter === '"') {
                        dentroDeComillas = !dentroDeComillas;
                    } else if (caracter === separador && !dentroDeComillas) {
                        resultado.push(campo.trim());
                        campo = '';
                    } else {
                        campo += caracter;
                    }
                }
                resultado.push(campo.trim());
                
                return resultado;
            }
            
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (line) {
                    const columns = dividirLineaCSV(line);
                    
                    if (columns.length >= 4) {
                        const medicamento = {
                            codigo: columns[0].replace(/"/g, '').trim(),
                            distintivo: columns[1].replace(/"/g, '').trim(),
                            presentacion: columns[2].replace(/"/g, '').trim(),
                            generico: columns[3].replace(/"/g, '').trim()
                        };
                        
                        if (medicamento.codigo) {
                            result.push(medicamento);
                        }
                    }
                }
            }
            
            return result;
        }

        function parseCSVMedicos(data) {
            const lines = data.split('\n');
            const result = [];
            
            let separador = ',';
            const primeraLinea = lines[0] || '';
            
            if (primeraLinea.includes('\t')) {
                separador = '\t';
            } else if (primeraLinea.includes(';')) {
                separador = ';';
            }
            
            function dividirLineaCSV(linea) {
                const resultado = [];
                let campo = '';
                let dentroDeComillas = false;
                
                for (let i = 0; i < linea.length; i++) {
                    const caracter = linea[i];
                    
                    if (caracter === '"') {
                        dentroDeComillas = !dentroDeComillas;
                    } else if (caracter === separador && !dentroDeComillas) {
                        resultado.push(campo.trim());
                        campo = '';
                    } else {
                        campo += caracter;
                    }
                }
                resultado.push(campo.trim());
                
                return resultado;
            }
            
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (line) {
                    const columns = dividirLineaCSV(line);
                    
                    if (columns.length >= 4) {
                        const medico = {
                            cedula: columns[0].replace(/"/g, '').trim(),
                            nombre: columns[1].replace(/"/g, '').trim(),
                            direccion: columns[2].replace(/"/g, '').trim(),
                            telefono: columns[3].replace(/"/g, '').trim()
                        };
                        
                        if (medico.cedula) {
                            result.push(medico);
                        }
                    }
                }
            }
            
            return result;
        }

        function buscarMedicamento(tipo) {
            const codigo = document.getElementById(`codigo_${tipo}`).value.trim();
            const resultadosDiv = document.getElementById(`resultados_${tipo}`);
            
            if (codigo.length < 2) {
                resultadosDiv.classList.remove('show');
                return;
            }
            
            const resultados = medicamentosCSV.filter(med => 
                med.codigo.toLowerCase().includes(codigo.toLowerCase()) ||
                med.distintivo.toLowerCase().includes(codigo.toLowerCase()) ||
                med.generico.toLowerCase().includes(codigo.toLowerCase())
            );
            
            if (resultados.length > 0) {
                resultadosDiv.innerHTML = '';
                resultados.slice(0, 10).forEach(med => {
                    const item = document.createElement('div');
                    item.className = 'search-result-item';
                    item.innerHTML = `
                        <strong>${med.codigo}</strong> - ${med.distintivo}<br>
                        <small>${med.generico} | ${med.presentacion}</small>
                    `;
                    item.onclick = () => seleccionarMedicamento(tipo, med);
                    resultadosDiv.appendChild(item);
                });
                resultadosDiv.classList.add('show');
            } else {
                resultadosDiv.classList.remove('show');
            }
        }

        function buscarMedicamentoExacto(tipo) {
            const codigo = document.getElementById(`codigo_${tipo}`).value.trim();
            
            const medicamento = medicamentosCSV.find(med => 
                med.codigo === codigo || 
                med.distintivo.toLowerCase() === codigo.toLowerCase() ||
                med.generico.toLowerCase() === codigo.toLowerCase()
            );
            
            if (medicamento) {
                seleccionarMedicamento(tipo, medicamento);
            } else {
                alert('⚠️ No se encontró el medicamento en la base de datos CSV');
            }
        }

        function seleccionarMedicamento(tipo, medicamento) {
            document.getElementById(`codigo_${tipo}`).value = medicamento.codigo;
            document.getElementById(`generico_${tipo}`).value = medicamento.generico;
            document.getElementById(`distintivo_${tipo}`).value = medicamento.distintivo;
            document.getElementById(`presentacion_${tipo}`).value = medicamento.presentacion;
            
            document.getElementById(`resultados_${tipo}`).classList.remove('show');
        }

        function buscarMedico() {
            const cedula = document.getElementById('cedula_salida').value.trim();
            const resultadosDiv = document.getElementById('resultados_medicos');
            
            if (cedula.length < 2) {
                resultadosDiv.classList.remove('show');
                return;
            }
            
            const resultados = medicosCSV.filter(med => 
                med.cedula.toLowerCase().includes(cedula.toLowerCase()) ||
                med.nombre.toLowerCase().includes(cedula.toLowerCase())
            );
            
            if (resultados.length > 0) {
                resultadosDiv.innerHTML = '';
                resultados.slice(0, 10).forEach(med => {
                    const item = document.createElement('div');
                    item.className = 'search-result-item';
                    item.innerHTML = `
                        <strong>${med.cedula}</strong> - ${med.nombre}<br>
                        <small>${med.direccion} | ${med.telefono}</small>
                    `;
                    item.onclick = () => seleccionarMedico(med);
                    resultadosDiv.appendChild(item);
                });
                resultadosDiv.classList.add('show');
            } else {
                resultadosDiv.classList.remove('show');
            }
        }

        function buscarMedicoExacto() {
            const cedula = document.getElementById('cedula_salida').value.trim();
            
            const medico = medicosCSV.find(med => 
                med.cedula === cedula || 
                med.nombre.toLowerCase() === cedula.toLowerCase()
            );
            
            if (medico) {
                seleccionarMedico(medico);
            } else {
                alert('⚠️ No se encontró el médico en la base de datos CSV');
            }
        }

        function seleccionarMedico(medico) {
            document.getElementById('cedula_salida').value = medico.cedula;
            document.getElementById('nombre_medico').value = medico.nombre;
            document.getElementById('direccion_medico').value = medico.direccion;
            document.getElementById('telefono_medico').value = medico.telefono;
            
            document.getElementById('resultados_medicos').classList.remove('show');
        }

        function agregarEntrada() {
            const entrada = {
                tipo: 'entrada',
                fecha: document.getElementById('fecha_entrada').value,
                codigo: document.getElementById('codigo_entrada').value,
                generico: document.getElementById('generico_entrada').value,
                distintivo: document.getElementById('distintivo_entrada').value,
                presentacion: document.getElementById('presentacion_entrada').value,
                aware: document.getElementById('aware_entrada').value,
                lote: document.getElementById('lote_entrada').value,
                caducidad: document.getElementById('caducidad_entrada').value,
                existencia: document.getElementById('existencia_entrada').value,
                surtido: '',
                saldo: document.getElementById('existencia_entrada').value,
                movimiento: 'ENTRADA',
                folio: '',
                cedula: '',
                nombre: document.getElementById('proveedor_entrada').value,
                direccion: '',
                telefono: ''
            };
            
            if (!entrada.fecha || !entrada.codigo || !entrada.generico) {
                alert('⚠️ Por favor complete los campos obligatorios: Fecha, Código y Genérico');
                return;
            }
            
            registros.push(entrada);
            actualizarTabla();
            limpiarFormularioEntrada();
            alert('✅ Entrada registrada exitosamente');
        }

        function agregarSalida() {
            const salida = {
                tipo: 'salida',
                fecha: document.getElementById('fecha_salida').value,
                codigo: document.getElementById('codigo_salida').value,
                generico: document.getElementById('generico_salida').value,
                distintivo: document.getElementById('distintivo_salida').value,
                presentacion: document.getElementById('presentacion_salida').value,
                aware: document.getElementById('aware_salida').value,
                lote: document.getElementById('lote_salida').value,
                caducidad: document.getElementById('caducidad_salida').value,
                existencia: '',
                surtido: document.getElementById('surtido_salida').value,
                saldo: calcularSaldo(document.getElementById('codigo_salida').value, document.getElementById('surtido_salida').value),
                movimiento: document.getElementById('movimiento_salida').value,
                folio: document.getElementById('folio_salida').value,
                cedula: document.getElementById('cedula_salida').value,
                nombre: document.getElementById('nombre_medico').value,
                direccion: document.getElementById('direccion_medico').value,
                telefono: document.getElementById('telefono_medico').value
            };
            
            if (!salida.fecha || !salida.codigo || !salida.surtido) {
                alert('⚠️ Por favor complete los campos obligatorios: Fecha, Código y Surtido');
                return;
            }
            
            registros.push(salida);
            actualizarTabla();
            limpiarFormularioSalida();
            alert('✅ Salida registrada exitosamente');
        }

        function calcularSaldo(codigo, surtido) {
            let ultimoSaldo = 0;
            for (let i = registros.length - 1; i >= 0; i--) {
                if (registros[i].codigo === codigo && registros[i].tipo === 'entrada') {
                    ultimoSaldo = parseInt(registros[i].saldo) || 0;
                    break;
                }
            }
            return ultimoSaldo - parseInt(surtido);
        }

        function agregarMedico() {
            const telefono = document.getElementById('telefono_medico_registro').value;
            if (telefono && telefono.length !== 10) {
                alert('⚠️ El teléfono debe tener exactamente 10 dígitos');
                return;
            }
            
            const medico = {
                cedula: document.getElementById('cedula_medico_registro').value,
                nombre: document.getElementById('nombre_medico_registro').value,
                especialidad: document.getElementById('especialidad_medico').value,
                direccion: document.getElementById('direccion_medico_registro').value,
                telefono: telefono,
                email: document.getElementById('email_medico').value
            };
            
            if (!medico.cedula || !medico.nombre) {
                alert('⚠️ Por favor complete los campos obligatorios: Cédula y Nombre');
                return;
            }
            
            medicos.push(medico);
            limpiarFormularioMedico();
            alert('✅ Médico registrado exitosamente');
        }

        function agregarProveedor() {
            const telefono = document.getElementById('telefono_proveedor').value;
            if (telefono && telefono.length !== 10) {
                alert('⚠️ El teléfono debe tener exactamente 10 dígitos');
                return;
            }
            
            const proveedor = {
                empresa: document.getElementById('empresa_proveedor').value,
                rfc: document.getElementById('rfc_proveedor').value,
                contacto: document.getElementById('contacto_proveedor').value,
                direccion: document.getElementById('direccion_proveedor').value,
                telefono: telefono,
                email: document.getElementById('email_proveedor').value
            };
            
            if (!proveedor.empresa || !proveedor.rfc) {
                alert('⚠️ Por favor complete los campos obligatorios: Empresa y RFC');
                return;
            }
            
            proveedores.push(proveedor);
            limpiarFormularioProveedor();
            alert('✅ Proveedor registrado exitosamente');
        }

        function actualizarTabla() {
            const tbody = document.getElementById('cuerpo_tabla_resultados');
            const tbodyInventario = document.getElementById('cuerpo_tabla_inventario');
            
            tbody.innerHTML = '';
            tbodyInventario.innerHTML = '';
            
            registros.forEach((registro, index) => {
                const fila = document.createElement('tr');
                fila.innerHTML = `
                    <td>
                        <button class="btn-edit" onclick="editarRegistro(${index})">✏️ Editar</button>
                        <button class="btn-delete" onclick="eliminarRegistro(${index})">🗑️</button>
                    </td>
                    <td>${registro.fecha || ''}</td>
                    <td>${registro.codigo || ''}</td>
                    <td>${registro.generico || ''}</td>
                    <td>${registro.distintivo || ''}</td>
                    <td>${registro.presentacion || ''}</td>
                    <td>${registro.aware || ''}</td>
                    <td>${registro.lote || ''}</td>
                    <td>${registro.caducidad || ''}</td>
                    <td>${registro.existencia || ''}</td>
                    <td>${registro.surtido || ''}</td>
                    <td>${registro.saldo || ''}</td>
                    <td>${registro.movimiento || ''}</td>
                    <td>${registro.folio || ''}</td>
                    <td>${registro.cedula || ''}</td>
                    <td>${registro.nombre || ''}</td>
                    <td>${registro.direccion || ''}</td>
                    <td>${registro.telefono || ''}</td>
                `;
                tbody.appendChild(fila);
                
                const filaInventario = document.createElement('tr');
                filaInventario.innerHTML = `
                    <td>${registro.fecha || ''}</td>
                    <td>${registro.codigo || ''}</td>
                    <td>${registro.generico || ''}</td>
                    <td>${registro.distintivo || ''}</td>
                    <td>${registro.presentacion || ''}</td>
                    <td>${registro.aware || ''}</td>
                    <td>${registro.lote || ''}</td>
                    <td>${registro.caducidad || ''}</td>
                    <td>${registro.existencia || ''}</td>
                    <td>${registro.surtido || ''}</td>
                    <td>${registro.saldo || ''}</td>
                    <td>${registro.movimiento || ''}</td>
                    <td>${registro.folio || ''}</td>
                    <td>${registro.cedula || ''}</td>
                    <td>${registro.nombre || ''}</td>
                    <td>${registro.direccion || ''}</td>
                    <td>${registro.telefono || ''}</td>
                `;
                tbodyInventario.appendChild(filaInventario);
            });
        }

        function editarRegistro(index) {
            registroEditando = index;
            const registro = registros[index];
            
            document.getElementById('edit_fecha').value = registro.fecha || '';
            document.getElementById('edit_codigo').value = registro.codigo || '';
            document.getElementById('edit_generico').value = registro.generico || '';
            document.getElementById('edit_distintivo').value = registro.distintivo || '';
            document.getElementById('edit_presentacion').value = registro.presentacion || '';
            document.getElementById('edit_aware').value = registro.aware || 'ACCESS';
            document.getElementById('edit_lote').value = registro.lote || '';
            document.getElementById('edit_caducidad').value = registro.caducidad || '';
            document.getElementById('edit_existencia').value = registro.existencia || '';
            document.getElementById('edit_surtido').value = registro.surtido || '';
            document.getElementById('edit_saldo').value = registro.saldo || '';
            document.getElementById('edit_movimiento').value = registro.movimiento || '';
            document.getElementById('edit_folio').value = registro.folio || '';
            document.getElementById('edit_cedula').value = registro.cedula || '';
            document.getElementById('edit_nombre').value = registro.nombre || '';
            document.getElementById('edit_direccion').value = registro.direccion || '';
            document.getElementById('edit_telefono').value = registro.telefono || '';
            
            document.getElementById('modal_edicion').classList.add('show');
        }

        function guardarEdicion() {
            if (registroEditando !== null) {
                const registro = registros[registroEditando];
                
                registro.fecha = document.getElementById('edit_fecha').value;
                registro.codigo = document.getElementById('edit_codigo').value;
                registro.generico = document.getElementById('edit_generico').value;
                registro.distintivo = document.getElementById('edit_distintivo').value;
                registro.presentacion = document.getElementById('edit_presentacion').value;
                registro.aware = document.getElementById('edit_aware').value;
                registro.lote = document.getElementById('edit_lote').value;
                registro.caducidad = document.getElementById('edit_caducidad').value;
                registro.existencia = document.getElementById('edit_existencia').value;
                registro.surtido = document.getElementById('edit_surtido').value;
                registro.saldo = document.getElementById('edit_saldo').value;
                registro.movimiento = document.getElementById('edit_movimiento').value;
                registro.folio = document.getElementById('edit_folio').value;
                registro.cedula = document.getElementById('edit_cedula').value;
                registro.nombre = document.getElementById('edit_nombre').value;
                registro.direccion = document.getElementById('edit_direccion').value;
                registro.telefono = document.getElementById('edit_telefono').value;
                
                actualizarTabla();
                cerrarModal();
                alert('✅ Registro actualizado exitosamente');
            }
        }

        function eliminarRegistro(index) {
            if (confirm('¿Estás seguro de eliminar este registro?')) {
                registros.splice(index, 1);
                actualizarTabla();
                alert('✅ Registro eliminado exitosamente');
            }
        }

        function cerrarModal() {
            document.getElementById('modal_edicion').classList.remove('show');
            registroEditando = null;
        }

        function exportarExcel(tipo) {
            const datos = registros.filter(r => r.tipo === tipo);
            
            if (datos.length === 0) {
                alert('⚠️ No hay datos para exportar');
                return;
            }
            
            let csv = 'Fecha,Código,Genérico,Distintivo,Presentación,AWARE,Lote,Caducidad,Existencia,Surtido,Saldo,Movimiento,Folio,Cédula,Nombre,Dirección,Teléfono\n';
            
            datos.forEach(dato => {
                csv += `${dato.fecha || ''},${dato.codigo || ''},${dato.generico || ''},${dato.distintivo || ''},${dato.presentacion || ''},${dato.aware || ''},${dato.lote || ''},${dato.caducidad || ''},${dato.existencia || ''},${dato.surtido || ''},${dato.saldo || ''},${dato.movimiento || ''},${dato.folio || ''},${dato.cedula || ''},${dato.nombre || ''},${dato.direccion || ''},${dato.telefono || ''}\n`;
            });
            
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            
            link.setAttribute('href', url);
            link.setAttribute('download', `registro_${tipo}_${new Date().toISOString().split('T')[0]}.csv`);
            link.style.visibility = 'hidden';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            alert(`✅ Archivo Excel exportado exitosamente`);
        }

        function limpiarFormularioEntrada() {
            document.getElementById('fecha_entrada').value = '';
            document.getElementById('codigo_entrada').value = '';
            document.getElementById('generico_entrada').value = '';
            document.getElementById('distintivo_entrada').value = '';
            document.getElementById('presentacion_entrada').value = '';
            document.getElementById('lote_entrada').value = '';
            document.getElementById('caducidad_entrada').value = '';
            document.getElementById('existencia_entrada').value = '';
            document.getElementById('proveedor_entrada').value = '';
            
            const hoy = new Date().toISOString().split('T')[0];
            document.getElementById('fecha_entrada').value = hoy;
        }

        function limpiarFormularioSalida() {
            document.getElementById('fecha_salida').value = '';
            document.getElementById('codigo_salida').value = '';
            document.getElementById('generico_salida').value = '';
            document.getElementById('distintivo_salida').value = '';
            document.getElementById('presentacion_salida').value = '';
            document.getElementById('lote_salida').value = '';
            document.getElementById('caducidad_salida').value = '';
            document.getElementById('surtido_salida').value = '';
            document.getElementById('movimiento_salida').value = 'Venta al público';
            document.getElementById('folio_salida').value = '';
            document.getElementById('cedula_salida').value = '';
            document.getElementById('nombre_medico').value = '';
            document.getElementById('direccion_medico').value = '';
            document.getElementById('telefono_medico').value = '';
            
            const hoy = new Date().toISOString().split('T')[0];
            document.getElementById('fecha_salida').value = hoy;
        }

        function limpiarFormularioMedico() {
            document.getElementById('cedula_medico_registro').value = '';
            document.getElementById('nombre_medico_registro').value = '';
            document.getElementById('especialidad_medico').value = '';
            document.getElementById('direccion_medico_registro').value = '';
            document.getElementById('telefono_medico_registro').value = '';
            document.getElementById('email_medico').value = '';
        }

        function limpiarFormularioProveedor() {
            document.getElementById('empresa_proveedor').value = '';
            document.getElementById('rfc_proveedor').value = '';
            document.getElementById('contacto_proveedor').value = '';
            document.getElementById('direccion_proveedor').value = '';
            document.getElementById('telefono_proveedor').value = '';
            document.getElementById('email_proveedor').value = '';
        }

        // Inicializar secciones
        document.querySelectorAll('.form-section').forEach(section => {
            section.style.display = 'none';
        });
        document.getElementById('entradas').style.display = 'block';
    </script>
